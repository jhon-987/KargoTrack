//*CREATE DATABASE IF NOT EXISTS kargotrack
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;
USE kargotrack;

CREATE TABLE IF NOT EXISTS encomiendas (
    id_encomienda INT AUTO_INCREMENT PRIMARY KEY,
    descripcion VARCHAR(255) NOT NULL,
    estado VARCHAR(50) NOT NULL DEFAULT 'Registrado'
);

CREATE TABLE IF NOT EXISTS seguimientos (
    id_seguimiento INT AUTO_INCREMENT PRIMARY KEY,
    id_encomienda INT NOT NULL,
    fecha DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    ubicacion VARCHAR(150) NOT NULL,
    estado VARCHAR(50) NOT NULL,
    FOREIGN KEY (id_encomienda)
        REFERENCES encomiendas(id_encomienda)
);

CREATE TABLE IF NOT EXISTS entregas (
    id_entrega INT AUTO_INCREMENT PRIMARY KEY,
    id_encomienda INT NOT NULL,
    fecha_entrega DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    receptor VARCHAR(150) NOT NULL,
    observacion VARCHAR(255),
    FOREIGN KEY (id_encomienda)
        REFERENCES encomiendas(id_encomienda)
);

INSERT INTO encomiendas (descripcion, estado)
SELECT 'Paquete de prueba KargoTrack', 'Registrado'
WHERE NOT EXISTS (
    SELECT 1 FROM encomiendas
);
